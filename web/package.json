{
  "name": "3d-lab-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:playback": "cargo run --manifest-path ../Cargo.toml -p three-d-playback --example export_playback_fixture -- public/generated/playback-fixture.json",
    "dev": "bun run generate:playback && next dev",
    "build": "bun run generate:playback && next build",
    "typecheck": "tsc --noEmit",
    "test": "bun run generate:playback && bun test"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.185.4",
    "@webgpu/types": "0.1.72",
    "typescript": "5.9.2"
  }
}
